[Unit]
Description=Molan PostgreSQL Job Worker
After=network-online.target molan.service postgresql.service
Wants=network-online.target
Requires=molan.service

[Service]
Type=simple
User=molan
Group=molan
WorkingDirectory=/opt/molan
Environment=NODE_ENV=production
Environment=MOLAN_PG_ENABLED=1
Environment=MOLAN_PG_HOST=127.0.0.1
Environment=MOLAN_PG_PORT=5432
Environment=MOLAN_PG_DATABASE=molan
Environment=MOLAN_PG_WORKER_USER=novel_worker_runtime
Environment=MOLAN_PG_WORKER_PASSWORD_FILE=/etc/molan/pg-worker.pass
Environment=MOLAN_PG_WORKER_ROLE=novel_worker
Environment=MOLAN_WORKER_API_URL=http://127.0.0.1:3000
Environment=MOLAN_WORKER_PROVIDER=platform
Environment=MOLAN_WORKER_LEASE_SECONDS=600
ExecStart=/usr/local/bin/node --no-warnings /opt/molan/scripts/pg-job-worker.mjs --loop
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
