{
  "name": "molan-home",
  "version": "1.0.0",
  "description": "墨阑 AI 小说创作平台 · 落地页（1:1 复刻 首页.html + 真实交互）",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "test": "node --no-warnings --test --test-reporter=spec \"test/**/*.test.js\" \"test/**/*.test.mjs\" \"test/**/*.test.cjs\"",
    "ci": "node --no-warnings --test --test-reporter=spec \"test/**/*.test.js\" \"test/**/*.test.mjs\" \"test/**/*.test.cjs\" && node scripts/production-import-audit.mjs && node scripts/audit-golden-suite.mjs && node scripts/audit-features.mjs",
    "audit:production-imports": "node scripts/production-import-audit.mjs",
    "corpus:cli": "node scripts/corpus-cli.js",
    "corpus:extract": "node scripts/corpus-cli.js extract",
    "corpus:cluster": "node scripts/corpus-cli.js cluster",
    "corpus:build-strategy": "node scripts/corpus-cli.js build-strategy",
    "corpus:discover-patterns": "node scripts/corpus-cli.js discover-patterns",
    "corpus:quality-report": "node scripts/corpus-cli.js quality-report",
    "corpus:publish": "node scripts/corpus-cli.js publish",
    "audit:features": "node scripts/audit-features.mjs",
    "audit:golden": "node scripts/audit-golden-suite.mjs",
    "quality:promote": "node scripts/promote-quality-config.mjs",
    "baseline:build": "node scripts/build-generation-baseline.mjs --write",
    "baseline:record": "node scripts/record-baseline.mjs",
    "soak:run": "node --no-warnings scripts/run-soak-test.mjs",
    "test:slow": "node -e \"process.env.MOLAN_SLOW_TESTS='1';process.exit(require('node:child_process').spawnSync(process.execPath,['--no-warnings','--test','test/v31-stage0.test.mjs'],{stdio:'inherit',env:process.env}).status||0)\"",
    "db:pg:check": "node scripts/migrate-postgres.mjs --check",
    "db:pg:apply": "node scripts/migrate-postgres.mjs --apply",
    "db:pg:backup": "node scripts/postgres-backup.mjs backup",
    "db:pg:restore-drill": "node scripts/postgres-backup.mjs restore-drill",
    "db:pg:role": "node scripts/setup-local-postgres-role.mjs",
    "db:pg:smoke": "node scripts/postgres-runtime-smoke.mjs",
    "db:pg:http-smoke": "node scripts/postgres-http-smoke.mjs",
    "db:pg:multi-smoke": "node scripts/postgres-multi-instance-smoke.mjs",
    "db:pg:app-instance-smoke": "node scripts/postgres-app-instance-smoke.mjs",
    "db:pg:job-smoke": "node scripts/postgres-job-smoke.mjs",
    "db:pg:billing-smoke": "node scripts/postgres-billing-smoke.mjs",
    "db:pg:worker": "node scripts/pg-job-worker.mjs",
    "db:pg:worker-smoke": "node scripts/postgres-worker-smoke.mjs",
    "db:pg:reconcile": "node scripts/sqlite-migration/postgres-migration-reconcile.mjs",
    "db:pg:migrate-sqlite-full": "node scripts/sqlite-migration/migrate-sqlite-full.mjs",
    "db:pg:reconcile-sqlite-full": "node scripts/sqlite-migration/reconcile-sqlite-full.mjs",
    "db:sqlite:clone": "node scripts/sqlite-migration/clone-sqlite-database.mjs",
    "db:sqlite:test": "node scripts/sqlite-migration/run-tests.mjs",
    "db:pg:migrate-sqlite": "node scripts/sqlite-migration/migrate-sqlite-projects.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "keywords": [],
  "author": "",
  "dependencies": {
    "pg": "^8.16.3",
    "playwright-core": "^1.62.0"
  }
}
